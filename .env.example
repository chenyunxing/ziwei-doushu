# 复制为 .env.local 后填入实际值

# ─── AI 推理（OpenAI 兼容协议，任选一家）───
# /api/interpret 与 /api/heming 的「现写」会读取这里的 Key。只排盘、只看 v4.0 成稿可以留空。
AI_PROVIDER=deepseek
DEEPSEEK_API_KEY=your-deepseek-api-key
DEEPSEEK_MODEL=deepseek-flash

# 13 维成稿目录，里面是 year-1950.jsonl 到 year-2026.jsonl。不填则用项目下 data/interp-v4
# INTERP_DATA_DIR=D:/workspace/ziwei-interp-data/v4

# ─── 或用其他 OpenAI 兼容模型 ───
# AI_PROVIDER=mimo
# MIMO_API_KEY=your-api-key
# MIMO_BASE_URL=https://your-provider/v1
# MIMO_MODEL=model-name

# ─── 站点 ───
NEXT_PUBLIC_SITE_URL=http://localhost:3000
